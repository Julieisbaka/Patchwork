{
	"schemaVersion": 1,
	"id": "patchwork",
	"version": "${version}",
	"name": "Patchwork",
	"description": "A Fabric mod for Minecraft Java Edition that adds a patchwork of new features and changes to the game.",
	"authors": [
		"JulieISBaka"
	],
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.JulieISBaka.patchwork.Patchwork"
		],
		"client": [
			"com.JulieISBaka.patchwork.client.PatchworkClient"
		],
		"modmenu": [
			"com.JulieISBaka.patchwork.client.PatchworkModMenu"
		]
	},
	"mixins": [
		"patchwork.mixins.json",
		{
			"config": "patchwork.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
