{
	"schemaVersion": 1,
	"id": "patchwork",
	"version": "${version}",
	"name": "Patchwork",
	"description": "Adds new building blocks, crafting options, mob behaviors, and configurable gameplay changes.",
	"authors": [
		"JulieISBaka"
	],
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.JulieISBaka.patchwork.Patchwork"
		],
		"fabric-gametest": [
			"com.JulieISBaka.patchwork.config.PatchworkConfigGameTests",
			"com.JulieISBaka.patchwork.features.blocks.PatchworkBlocksGameTests",
			"com.JulieISBaka.patchwork.features.combat.PatchworkCombatGameTests",
			"com.JulieISBaka.patchwork.features.gameplay.PatchworkGameplayGameTests",
			"com.JulieISBaka.patchwork.features.items.PatchworkItemsGameTests",
			"com.JulieISBaka.patchwork.features.mobs.PatchworkMobsGameTests",
			"com.JulieISBaka.patchwork.features.world.PatchworkWorldGameTests"
		],
		"fabric-client-gametest": [
			"com.JulieISBaka.patchwork.client.PatchworkClientGameTests"
		],
		"client": [
			"com.JulieISBaka.patchwork.client.PatchworkClient"
		],
		"modmenu": [
			"com.JulieISBaka.patchwork.client.PatchworkModMenu"
		]
	},
	"mixins": [
		"patchwork.mixins.json",
		{
			"config": "patchwork.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}